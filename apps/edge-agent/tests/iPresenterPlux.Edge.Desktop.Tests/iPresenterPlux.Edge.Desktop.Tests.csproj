<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Test-local awaits intentionally pass CancellationToken.None (xunit.v3 analyzer advisory). -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- xunit.v3 is required by Avalonia.Headless.XUnit 12.x (headless UI-construction tests). -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <ProjectReference Include="../../src/iPresenterPlux.Edge.Desktop/iPresenterPlux.Edge.Desktop.csproj" />
    <ProjectReference Include="../../src/Lightworld.Update.Client/Lightworld.Update.Client.csproj" />
  </ItemGroup>
</Project>
