[Unit]
Description=iPresenterPlux private ASR worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightworld
Group=lightworld
WorkingDirectory=/home/lightworld/webapps/ipresenterplux-asr/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=IPRESENTERPLUX_ASR_HOST=127.0.0.1
Environment=IPRESENTERPLUX_ASR_PORT=8765
Environment=IPRESENTERPLUX_ASR_MODEL=small
Environment=IPRESENTERPLUX_ASR_MODEL_DIR=/home/lightworld/webapps/ipresenterplux-asr/models
Environment=IPRESENTERPLUX_ASR_LOCAL_FILES_ONLY=true
Environment=IPRESENTERPLUX_ASR_DEVICE=cpu
Environment=IPRESENTERPLUX_ASR_COMPUTE_TYPE=int8
Environment=IPRESENTERPLUX_ASR_BEAM_SIZE=3
Environment=IPRESENTERPLUX_ASR_MAX_AUDIO_BYTES=1000000
ExecStart=/home/lightworld/webapps/ipresenterplux-asr/venv/bin/ipresenterplux-asr
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/lightworld/webapps/ipresenterplux-asr
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
